# Public Mapbox token. It is visible in the browser.
# https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Umami. Public, because the browser loads these scripts.
# Host can be a domain or an origin, for example umami.guoqi.dev
NEXT_PUBLIC_UMAMI_HOST=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
