# Prefer environment variables. Do not commit this file with real values.
IGPSPORT_PHONE=
IGPSPORT_PASSWORD=
# Optional. Login response access_token. When set, phone and password are not used.
IGPSPORT_ACCESS_TOKEN=
# Directory for original iGPSPORT FIT files. Ignored by git.
ACTIVITY_DATA_DIR=data/igpsport

# Strava API application. strava-sync reads these. Do not commit real values.
# How to get them: docs/refresh-data.md
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
